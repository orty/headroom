# Copy to .env.local (git-ignored) and fill in. deploy.sh, check.sh and
# test-deploy.sh read it; none of these values belong in tracked files.

# Azure subscription id, resource group and region of the deployment.
SUB=
RG=
LOCATION=
# Container Apps environment name, and its default domain
# (az containerapp env show -n <env> -g <rg> --query properties.defaultDomain).
ENV=
ENV_DOMAIN=
# Entra tenant id.
TENANT=
# Optional: client id of an existing headroom-dashboard app registration.
# Empty: deploy.sh finds it by display name, or creates it.
APP_ID=
# Dashboard custom hostname, and the hostname of the headroom proxy itself.
HOST=
PROXY_HOST=

# Optional, not read by the scripts: other environment-specific strings
# (DNS TXT verification id, revision names...) that test-deploy.sh must keep
# out of tracked files. Any NAME=value line here is checked.
